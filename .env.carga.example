# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN PARA CORRIDA DE CARGA (12 HORAS DESATENDIDAS)
# Archivo de ejemplo NO SECRETO (comitteable). Copiar valores a .env en el host.
# NUNCA incluir llaves ni credenciales en este archivo.
# ==============================================================================

# Fuente de datos para el daemon:
# "hoy"       -> Procesos publicados hoy (hora legal Colombia UTC-5) [Producción]
# "historico" -> Cola de prueba de días anteriores bajo data/dias/ (orden más reciente a más antiguo)
DAEMON_FUENTE=historico

# Meta de unidades de trabajo (definición oficial fin a fin: veredicto A1 + resumen A2 + docs A3 exitosos)
DAEMON_UNIDADES=1050

# Ventana máxima de ejecución desatendida en horas (p. ej., 12.5 horas; 0 = sin límite de tiempo)
DAEMON_HORAS=12.5

# Duración mínima obligatoria en horas desde el primer llamado al modelo (S4-7 / S4-FINAL: default 12.2h)
# El daemon no se detendrá antes de este lapso incluso si alcanza la meta de unidades.
DAEMON_HORAS_MINIMAS=12.2

# Ritmo por hora explícito (unidades/hora). Si no se define, se calcula como DAEMON_UNIDADES / DAEMON_HORAS (84 u/h)
# DAEMON_RITMO_POR_HORA=84

# Tamaño de lote de candidatos por ciclo (S4-FINAL: 6 para pacing suave con brecha promedio < 5 min)
DAEMON_LOTE=6

# Concurrencia de llamadas al modelo (S4-FINAL: 3 llamadas simultáneas; fallback a 2 si hay 429)
DAEMON_CONCURRENCIA=3

# Presupuesto duro en tokens (Calculado con pnpm config:final --saldo-usd=67 con 10% de reserva: 17.100.000 tokens)
DAEMON_PRESUPUESTO_TOKENS=17100000

# Presupuesto en USD (alternativo/adicional si config/precios.json tiene tarifas configuradas)
# DAEMON_PRESUPUESTO_USD=15.00

# Forzar arranque aun si el presupuesto configurado es inferior a la proyección P90 del estimador
DAEMON_IGNORAR_PROYECCION=false

# Parámetros opcionales para cola histórica (--fuente=historico):
# DAEMON_DESDE_ULTIMOS_DIAS=14
# DAEMON_FECHAS=2026-10-23,2026-10-19,2026-10-16,2026-10-15,2026-10-14,2026-10-13

# Modo dry-run para inspeccionar la cola y calcular proyección sin consumir créditos ni invocar modelos
DAEMON_DRY_RUN=false

# ==============================================================================
# NOTA DE SEGURIDAD:
# Las credenciales reales requeridas por el sistema (RETO_KEY, RETO_BASE_URL,
# LANGSMITH_API_KEY, LANGSMITH_PROJECT) deben residir EXCLUSIVAMENTE en el archivo
# .env local del host (ignorado en .gitignore y jamás copiado al contenedor Docker).
# ==============================================================================
