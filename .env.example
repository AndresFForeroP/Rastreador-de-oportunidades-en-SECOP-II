# Copy this file to .env and fill in the values. Never commit .env.

# API key for the Reto Agente 2026 OpenAI-compatible gateway (https://api.reto.pltk.mx/v1)
RETO_KEY=

# LangSmith tracing. If tracing is on but the key is empty/invalid, the app
# prints one warning and keeps running without traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secop-rastreador

# DEVELOPMENT ONLY (off by default): replaces today's date with YYYY-MM-DD.
# Production must always process today's publications only.
# SECOP_FECHA_PRUEBA=2026-10-15
